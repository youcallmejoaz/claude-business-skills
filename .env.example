# Copy to .env and edit. Never commit .env.

# 1 = run with zero API keys using sample data and recorded responses (default).
# 0 = call Claude for real (needs ANTHROPIC_API_KEY).
DEMO_MODE=1

# Only needed when DEMO_MODE=0. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Model that writes reports, owner briefs and customer replies.
WRITER_MODEL=claude-sonnet-5-5

# Model that turns quote emails into structured requests.
INTAKE_MODEL=claude-haiku-5-5

# Folder with the agency's CSV and Excel exports (read-only).
AGENCY_DATA_DIR=data

# "Today" for date maths such as quote age. Fixed in demo mode so results repeat.
# Leave empty in real mode to use the real date.
AS_OF_DATE=2026-10-23

# Skills Studio host and port. Keep 127.0.0.1 so it is only reachable from this machine.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000
